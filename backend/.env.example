# App
APP_NAME=Raya API
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./raya.db
DATABASE_URL_SYNC=sqlite:///./raya.db

# Redis (optional — not required for demo)
REDIS_URL=redis://localhost:6379/0

# Twilio (optional — for real phone calls in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MiniMax — Primary LLM for Darija conversations + risk analysis
# Get your key at: https://platform.minimaxi.com
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_GROUP_ID=

# Groq — Fast LLM fallback (Llama 3.3 70B)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ElevenLabs — TTS voice fallback (optional, Edge TTS is primary and free)
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# CORS
CORS_ORIGINS=["http://localhost:3000", "https://*.vercel.app"]

# Base URL
BASE_URL=http://localhost:8000
